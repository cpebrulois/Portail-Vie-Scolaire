# Fichiers à NE PAS téléverser comme assets statiques (syntaxe .gitignore).
# .git est la cause de l'échec « Asset too large » (pack de 271 Mo).
.git
node_modules
.assetsignore
.gitignore
worker.js
# Modules bundlés dans le Worker — NE JAMAIS servir en statique :
# kern_campagnes.js contient les « faits établis » (la solution des enquêtes).
kern_*.js
wrangler.jsonc
wrangler.toml
*.py
