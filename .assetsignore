# Fichiers à NE PAS téléverser comme assets statiques (syntaxe .gitignore).
# .git est la cause de l'échec « Asset too large » (pack de 271 Mo).
.git
node_modules
.assetsignore
.gitignore
worker.js
# Module bundlé dans le Worker — NE JAMAIS servir en statique : il contient
# les « faits établis », c'est-à-dire la solution des enquêtes.
# (nom exact, surtout PAS kern_*.js : kern_pillar_helpers.js est un asset
#  légitime chargé par index_PIXHARe.html)
kern_campagnes.js
wrangler.jsonc
wrangler.toml
*.py
# Schémas SQL : versionnés pour mémoire, jamais servis en statique.
*.sql
